{
  "name": "@dontbullymeillcode/react-three-vaporwave",
  "version": "1.0.2",
  "description": "Vaporwave components for React Three Fiber",
  "license": "MIT",
  "author": "Alexandra Smith <alexandra@dontbullymeillcode.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DontBullyMeIllCode/react-three-vaporwave.git"
  },
  "bugs": {
    "url": "https://github.com/DontBullyMeIllCode/react-three-vaporwave/issues"
  },
  "homepage": "https://github.com/DontBullyMeIllCode/react-three-vaporwave#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "three",
    "threejs",
    "react-three-fiber",
    "r3f",
    "vaporwave"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "previews": "storybook build --quiet && node scripts/capture-previews.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@react-three/drei": ">=10",
    "@react-three/fiber": ">=9",
    "react": ">=19",
    "three": ">=0.159"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/test-renderer": "^9.1.1",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "gifenc": "^1.0.3",
    "globals": "^17.12.0",
    "leva": "^0.10.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "three": "^0.186.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=20"
  }
}
